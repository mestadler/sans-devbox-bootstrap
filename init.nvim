" ~/.config/nvim/init.vim
" Neovim configuration file
" Last updated: 2025-03-08

" Source .vimrc for compatibility with Vim
set runtimepath^=~/.vim runtimepath+=~/.vim/after
let &packpath = &runtimepath
source ~/.vimrc

" Neovim-specific settings
" These settings will only apply to Neovim, not to Vim

" Python provider settings (if you use Python plugins)
" Uncomment and set these if you need specific Python executables
" let g:python_host_prog = '/usr/bin/python2'
" let g:python3_host_prog = '/usr/bin/python3'

" Plugin management
" If you want to use a plugin manager like vim-plug, add it here
" Example:
" call plug#begin('~/.local/share/nvim/plugged')
" Plug 'neovim/nvim-lspconfig'
" Plug 'nvim-treesitter/nvim-treesitter', {'do': ':TSUpdate'}
" call plug#end()

" Enhanced terminal options
" More convenient terminal usage in Neovim
augroup NeovimTerminal
  autocmd!
  " Start terminal in insert mode
  autocmd TermOpen * startinsert
  " Don't show line numbers in terminal
  autocmd TermOpen * setlocal nonumber norelativenumber
  " Easier navigation
  autocmd TermOpen * nnoremap <buffer> <C-c> i<C-c>
augroup END

" Additional keybindings for LSP and other Neovim-specific features
" would go here if you add those plugins
